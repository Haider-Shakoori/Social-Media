// Initial domain foundation; future batches add tenant authorization and workflow migrations.
// Do not persist OAuth access tokens, cookies or passwords in plaintext.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  EDITOR
  APPROVER
  VIEWER
}

enum ConnectionMode {
  OFFICIAL
  EXPERIMENTAL
  MANUAL
}

enum ConnectionState {
  DISCONNECTED
  CONNECTED
  LIMITED
  RESTRICTED
}

enum PostState {
  DRAFT
  APPROVAL_PENDING
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  UNCERTAIN
  FAILED
  MANUAL_REQUIRED
  CANCELLED
}

enum ApprovalState {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  email       String       @unique @db.VarChar(255)
  passwordHash String?     @map("password_hash") @db.Text
  fullName     String       @default("") @map("full_name") @db.VarChar(150)
  emailVerifiedAt DateTime? @map("email_verified_at")
  isPlatformAdmin Boolean @default(false) @map("is_platform_admin")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  memberships Membership[]
  sessions Session[]
  emailTokens EmailToken[]
  sentInvitations TenantInvitation[] @relation("SentInvitations")
  brandAccess BrandMember[]
  adminPayments PaymentRecord[] @relation("PaymentsRecorded")
  auditEvents BillingAuditEvent[]
  cmsEntries CmsEntry[] @relation("CmsAuthor")
  cmsEdits CmsEntry[] @relation("CmsEditor")
  platformAuditEvents PlatformAuditEvent[]
  platformSettings PlatformSetting[]

  @@map("users")
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique @db.VarChar(100)
  name        String       @db.VarChar(200)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  memberships Membership[]
  workspaces  Workspace[]
  invitations TenantInvitation[]
  subscription Subscription?
  invoices Invoice[]
  payments PaymentRecord[]
  usageBuckets UsageBucket[]
  billingAudits BillingAuditEvent[]

  @@map("tenants")
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  role      MembershipRole @default(VIEWER)
  createdAt DateTime       @default(now()) @map("created_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(200)
  timezone  String   @default("UTC") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brands    Brand[]

  @@index([tenantId])
  @@map("workspaces")
}

model Brand {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @map("workspace_id") @db.Uuid
  name        String             @db.VarChar(200)
  locale      String             @default("en") @db.VarChar(20)
  createdAt   DateTime           @default(now()) @map("created_at")
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connections SocialConnection[]
  posts       ContentPost[]
  members     BrandMember[]
  industry    String?  @db.VarChar(120)
  description String?  @db.Text
  website     String?  @db.VarChar(500)
  logoUrl     String?  @map("logo_url") @db.VarChar(500)
  primaryColor String  @default("#6ee7b7") @map("primary_color") @db.VarChar(7)
  targetAudience String? @map("target_audience") @db.Text
  tone         String? @db.VarChar(120)
  languages    String[] @default(["en"])
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  archivedAt   DateTime? @map("archived_at")

  @@index([workspaceId])
  @@map("brands")
}

model SocialConnection {
  id                   String          @id @default(uuid()) @db.Uuid
  brandId              String          @map("brand_id") @db.Uuid
  platform             String          @db.VarChar(40)
  mode                 ConnectionMode  @default(MANUAL)
  state                ConnectionState @default(DISCONNECTED)
  externalAccountId    String?         @map("external_account_id") @db.VarChar(255)
  encryptedCredentials String?         @map("encrypted_credentials") @db.Text
  createdAt            DateTime        @default(now()) @map("created_at")
  brand                Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  targets              PostTarget[]

  @@index([brandId, platform])
  @@map("social_connections")
}

model ContentPost {
  id        String       @id @default(uuid()) @db.Uuid
  brandId   String       @map("brand_id") @db.Uuid
  state     PostState    @default(DRAFT)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  brand     Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  versions  PostVersion[]
  targets   PostTarget[]

  @@index([brandId, state])
  @@map("content_posts")
}

model PostVersion {
  id        String            @id @default(uuid()) @db.Uuid
  postId    String            @map("post_id") @db.Uuid
  number    Int
  caption   String            @db.Text
  createdAt DateTime          @default(now()) @map("created_at")
  post      ContentPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  approvals ApprovalRequest[]

  @@unique([postId, number])
  @@map("post_versions")
}

model PostTarget {
  id                 String           @id @default(uuid()) @db.Uuid
  postId             String           @map("post_id") @db.Uuid
  socialConnectionId String           @map("social_connection_id") @db.Uuid
  state              PostState        @default(DRAFT)
  scheduledAt        DateTime?        @map("scheduled_at")
  remoteId           String?          @map("remote_id") @db.VarChar(255)
  createdAt          DateTime         @default(now()) @map("created_at")
  post               ContentPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialConnection   SocialConnection @relation(fields: [socialConnectionId], references: [id], onDelete: Restrict)

  @@unique([postId, socialConnectionId])
  @@index([state, scheduledAt])
  @@map("post_targets")
}

model ApprovalRequest {
  id             String        @id @default(uuid()) @db.Uuid
  postVersionId  String        @map("post_version_id") @db.Uuid
  state          ApprovalState @default(PENDING)
  expiresAt      DateTime      @map("expires_at")
  approvedAt     DateTime?     @map("approved_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  postVersion    PostVersion   @relation(fields: [postVersionId], references: [id], onDelete: Cascade)

  @@index([postVersionId, state])
  @@map("approval_requests")
}


enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String? @map("user_agent") @db.VarChar(300)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model EmailToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  purpose   EmailTokenPurpose
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("email_tokens")
}


model TenantInvitation {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  email        String @db.VarChar(255)
  role         MembershipRole
  tokenHash    String @unique @map("token_hash") @db.Char(64)
  invitedById  String @map("invited_by_id") @db.Uuid
  expiresAt    DateTime @map("expires_at")
  acceptedAt   DateTime? @map("accepted_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime @default(now()) @map("created_at")
  tenant       Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  invitedBy    User @relation("SentInvitations",fields:[invitedById],references:[id],onDelete:Restrict)

  @@unique([tenantId,email])
  @@index([email,expiresAt])
  @@map("tenant_invitations")
}

model BrandMember {
  id       String @id @default(uuid()) @db.Uuid
  brandId  String @map("brand_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  role     MembershipRole
  createdAt DateTime @default(now()) @map("created_at")
  brand    Brand @relation(fields:[brandId],references:[id],onDelete:Cascade)
  user     User @relation(fields:[userId],references:[id],onDelete:Cascade)

  @@unique([brandId,userId])
  @@index([userId])
  @@map("brand_members")
}


enum SubscriptionState {
  TRIALING
  ACTIVE
  GRACE
  SUSPENDED
  CANCELLED
  EXPIRED
}
enum BillingCycle {
  MONTHLY
  YEARLY
}
enum PaymentState {
  PENDING
  VERIFIED
  REJECTED
}
enum InvoiceState {
  ISSUED
  PAID
  VOID
}
enum UsageMetric {
  AI_TEXT
  AI_IMAGE
  SCHEDULED_POST
}

model Plan {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(60)
  name String @db.VarChar(100)
  description String @default("") @db.VarChar(500)
  currency String @default("USD") @db.Char(3)
  monthlyPriceMinor Int?
  yearlyPriceMinor Int?
  trialDays Int @default(14)
  maxBrands Int @default(1)
  maxSeats Int @default(2)
  maxConnections Int @default(1)
  monthlyAiText Int @default(25)
  monthlyAiImage Int @default(5)
  monthlyScheduledPosts Int @default(20)
  enabled Boolean @default(false)
  published Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  subscriptions Subscription[]
  invoices Invoice[]

  @@map("plans")
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid
  planId String @map("plan_id") @db.Uuid
  state SubscriptionState @default(TRIALING)
  cycle BillingCycle @default(MONTHLY)
  periodStart DateTime @map("period_start")
  periodEnd DateTime @map("period_end")
  trialEndsAt DateTime? @map("trial_ends_at")
  graceEndsAt DateTime? @map("grace_ends_at")
  suspendedAt DateTime? @map("suspended_at")
  cancelledAt DateTime? @map("cancelled_at")
  maxBrands Int
  maxSeats Int
  maxConnections Int
  monthlyAiText Int
  monthlyAiImage Int
  monthlyScheduledPosts Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  plan Plan @relation(fields:[planId],references:[id],onDelete:Restrict)
  payments PaymentRecord[]

  @@index([state,periodEnd])
  @@map("subscriptions")
}

model UsageBucket {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  metric UsageMetric
  monthStart DateTime @map("month_start")
  used Int @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)

  @@unique([tenantId,metric,monthStart])
  @@index([tenantId,monthStart])
  @@map("usage_buckets")
}

model Invoice {
  id String @id @default(uuid()) @db.Uuid
  number String @unique @db.VarChar(60)
  tenantId String @map("tenant_id") @db.Uuid
  planId String? @map("plan_id") @db.Uuid
  amountMinor Int
  currency String @db.Char(3)
  status InvoiceState @default(ISSUED)
  issuedAt DateTime @default(now()) @map("issued_at")
  dueAt DateTime? @map("due_at")
  paidAt DateTime? @map("paid_at")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  plan Plan? @relation(fields:[planId],references:[id],onDelete:SetNull)
  payments PaymentRecord[]

  @@index([tenantId,issuedAt])
  @@map("invoices")
}

model PaymentRecord {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  subscriptionId String? @map("subscription_id") @db.Uuid
  invoiceId String? @map("invoice_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  amountMinor Int
  currency String @db.Char(3)
  reference String @db.VarChar(120)
  note String @default("") @db.VarChar(500)
  state PaymentState @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")
  verifiedAt DateTime? @map("verified_at")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  subscription Subscription? @relation(fields:[subscriptionId],references:[id],onDelete:SetNull)
  invoice Invoice? @relation(fields:[invoiceId],references:[id],onDelete:SetNull)
  createdBy User @relation("PaymentsRecorded",fields:[createdById],references:[id],onDelete:Restrict)

  @@unique([tenantId,reference])
  @@index([tenantId,createdAt])
  @@map("payment_records")
}

model BillingAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  action String @db.VarChar(80)
  details Json
  createdAt DateTime @default(now()) @map("created_at")
  tenant Tenant? @relation(fields:[tenantId],references:[id],onDelete:SetNull)
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)

  @@index([tenantId,createdAt])
  @@map("billing_audit_events")
}


enum CmsEntryType {
  ARTICLE
  GUIDE
  PAGE
}

enum CmsEntryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CmsEntry {
  id String @id @default(uuid()) @db.Uuid
  type CmsEntryType
  locale String @default("en") @db.VarChar(12)
  slug String @db.VarChar(100)
  title String @db.VarChar(180)
  description String @db.VarChar(500)
  category String @db.VarChar(80)
  readingTime String @default("4 min") @map("reading_time") @db.VarChar(30)
  sections Json
  status CmsEntryStatus @default(DRAFT)
  revision Int @default(1)
  publishedAt DateTime? @map("published_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdById String @map("created_by_id") @db.Uuid
  updatedById String @map("updated_by_id") @db.Uuid
  createdBy User @relation("CmsAuthor",fields:[createdById],references:[id],onDelete:Restrict)
  updatedBy User @relation("CmsEditor",fields:[updatedById],references:[id],onDelete:Restrict)

  @@unique([type,locale,slug])
  @@index([status,type,locale,publishedAt])
  @@map("cms_entries")
}

model PlatformSetting {
  key String @id @db.VarChar(100)
  value Json
  updatedById String @map("updated_by_id") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy User @relation(fields:[updatedById],references:[id],onDelete:Restrict)

  @@map("platform_settings")
}

model PlatformAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  action String @db.VarChar(100)
  resourceType String @map("resource_type") @db.VarChar(60)
  resourceId String? @map("resource_id") @db.VarChar(150)
  details Json
  createdAt DateTime @default(now()) @map("created_at")
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)

  @@index([createdAt])
  @@index([resourceType,resourceId])
  @@map("platform_audit_events")
}
