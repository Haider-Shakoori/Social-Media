{
  "name": "@social/api",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:generate && nest start --watch",
    "build": "pnpm db:generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@social/shared": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/client": "6.19.3",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ioredis": "^5.4.2",
    "nodemailer": "^7.0.0",
    "zod": "^4.1.0",
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/node": "^22.0.0",
    "prisma": "6.19.3",
    "typescript": "^5.9.0",
    "@types/express": "^5.0.0",
    "@types/nodemailer": "^7.0.0"
  }
}
