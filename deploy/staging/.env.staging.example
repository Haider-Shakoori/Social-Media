# Copy to .env.staging ON THE VPS ONLY. Do not commit real values.
# Staging Compose explicitly enables client registration and skips email confirmation.
# Other environments continue requiring verification unless expressly configured.
# Use independent random credentials, URL-safe for DATABASE_URL and REDIS_URL.
POSTGRES_PASSWORD=REPLACE_WITH_A_NEW_RANDOM_HEX_SECRET
REDIS_PASSWORD=REPLACE_WITH_A_DIFFERENT_NEW_RANDOM_HEX_SECRET
DATABASE_URL=postgresql://social_stage:REPLACE_WITH_A_NEW_RANDOM_HEX_SECRET@postgres:5432/social_stage?schema=public
REDIS_URL=redis://:REPLACE_WITH_A_DIFFERENT_NEW_RANDOM_HEX_SECRET@redis:6379
SMTP_FROM=Social-Media Staging <no-reply@socials.businessos.af>
SMTP_SECURE=false
# Secrets should be kept out of GitHub and never logged.
SOCIAL_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BASE64_BYTES
