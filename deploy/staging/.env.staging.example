# Copy to .env.staging ON THE VPS ONLY. Do not commit real values.
# Staging Compose explicitly enables client registration and skips email confirmation.
# Other environments continue requiring verification unless expressly configured.
# Use independent random credentials, URL-safe for DATABASE_URL and REDIS_URL.
POSTGRES_PASSWORD=REPLACE_WITH_A_NEW_RANDOM_HEX_SECRET
REDIS_PASSWORD=REPLACE_WITH_A_DIFFERENT_NEW_RANDOM_HEX_SECRET
DATABASE_URL=postgresql://social_stage:REPLACE_WITH_A_NEW_RANDOM_HEX_SECRET@postgres:5432/social_stage?schema=public
REDIS_URL=redis://:REPLACE_WITH_A_DIFFERENT_NEW_RANDOM_HEX_SECRET@redis:6379
SMTP_FROM=Social-Media Staging <no-reply@socials.businessos.af>
SMTP_SECURE=false
# Secrets should be kept out of GitHub and never logged.
SOCIAL_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BASE64_BYTES

# Instagram Business Login (Meta professional accounts, no Facebook Page required).
# Keep disabled until the operator provides approved credentials and verifies routes.
INSTAGRAM_CONNECT_ENABLED=false
# INSTAGRAM_APP_ID=SET_IN_SERVER_ONLY
# INSTAGRAM_APP_SECRET=SET_IN_SERVER_ONLY
# INSTAGRAM_REDIRECT_URI=https://socials.businessos.af/api/v1/social/oauth/instagram/callback
# INSTAGRAM_SCOPES=instagram_business_basic
# For publisher review/test: Meta must grant instagram_business_content_publish, then
# reauthorize the Instagram account to receive the new scope. Never assume approval.
# INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
# Independent release control: stays OFF until media storage, review & all gates pass.
INSTAGRAM_IMAGE_PUBLISHING_ENABLED=false
# RelayWA WhatsApp approval requests: requires verified reviewers and configured session.
RELAYWA_APPROVALS_ENABLED=false

# Optional email review notifications; staging SMTP is Mailpit only.
# Never enable until the operator configures deliverable, authenticated SMTP.
APPROVAL_EMAIL_NOTIFICATIONS_ENABLED=false

# Approval emails require actual authenticated SMTP, verified recipients,
# and recipient opt-in. The default staging relay is Mailpit only.
# SMTP_HOST=YOUR_TRUSTED_SMTP_HOST
# SMTP_PORT=587
# SMTP_USER=YOUR_SMTP_USERNAME
# SMTP_PASSWORD=SET_PRIVATELY_ON_VPS
# SMTP_SECURE=false

# Optional Cloudflare R2 JPEG/PNG uploads (signed PUT, 8 MB maximum).
# Store credentials privately on VPS. Configure R2 bucket CORS for
# https://socials.businessos.af with PUT and Content-Type.
MEDIA_UPLOADS_ENABLED=false
# MEDIA_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# MEDIA_R2_BUCKET=YOUR_UPLOAD_BUCKET
# MEDIA_R2_ACCESS_KEY_ID=SET_PRIVATELY_ON_VPS
# MEDIA_R2_SECRET_ACCESS_KEY=SET_PRIVATELY_ON_VPS
# MEDIA_UPLOAD_SIGNING_KEY=BASE64_ENCODED_32_RANDOM_BYTES
# MEDIA_PUBLIC_BASE_URL=https://YOUR_PUBLIC_MEDIA_DOMAIN/
