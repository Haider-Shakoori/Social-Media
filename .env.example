# Local development only — never commit real secrets.
POSTGRES_DB=social_media
POSTGRES_USER=social_local
POSTGRES_PASSWORD=change-this-for-any-real-deployment
POSTGRES_PORT=5434
REDIS_PORT=6381
API_PORT=4000
SMTP_PORT=1025
MAILPIT_PORT=8025
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
WEB_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://social_local:change-this-for-any-real-deployment@127.0.0.1:5434/social_media?schema=public
REDIS_URL=redis://127.0.0.1:6381
SMTP_HOST=127.0.0.1
SMTP_FROM=Social-Media Development <no-reply@local.test>
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Public auth remains disabled until controlled beta access is approved.
REGISTRATION_ENABLED=false
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_INDEXING_ENABLED=false
PUBLIC_CONTACT_EMAIL=

# Batch 6 CMS remains intentionally disabled without explicit operator review.
CMS_PUBLISHING_ENABLED=false
CMS_PUBLIC_ENABLED=false
# Next.js server-only internal API URL (no secrets or user-supplied URLs)
# CMS_API_BASE_URL=http://127.0.0.1:4000/api/v1

# Batch 8 Meta + X pilot: disabled unless operator explicitly authorizes developer apps.
# Generate project-unique 32-byte key: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# SOCIAL_TOKEN_ENCRYPTION_KEY= (never commit; required before OAuth)
META_CONNECT_ENABLED=false
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=https://api.example.com/api/v1/social/oauth/meta/callback
X_CONNECT_ENABLED=false
X_API_BUDGET_APPROVED=false
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=https://api.example.com/api/v1/social/oauth/x/callback
X_API_MAX_MONTHLY_USD_MINOR=0
# X billing consent is only a flag; hard metered budget enforcement is NOT yet implemented.

# Batch 9: optional AI text; deterministic templates and SVG are always local.
AI_GENERATION_ENABLED=false
